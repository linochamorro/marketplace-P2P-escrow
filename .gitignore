# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Documentación de proceso (uso interno) — solo README.md de raíz se versiona
*.md
!/README.md
!docs/architecture/*.md
!docs/decisions/*.md
# Galería de imágenes: el README sí es público (H-2); las PNG no son .md
!docs/images/README.md

# Proceso interno de agentes — control local
.agents/
docs/avance/
docs/**/*.bak

# Exclusiones F01-T05 / CA-06 — temporales y runtime privado (nunca versionar)
# Runtime PostgreSQL privado y datos del clúster
.local/
# Clones y temporales de diagnóstico
temporary/
# Referencias de diseño Stitch, no capturas reales (CA-04)
docs/stitch-screens/

# Backend (Maven / Spring Boot)
target/
application-local.yml
application-local.properties

# Frontend (Next.js)
node_modules/
.next/
/out/
/build
coverage/
playwright-report/
test-results/
.vercel
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Variables de entorno (cualquier ubicación)
.env*
!**/.env.example

# Evidencia de procesos (Artifacts referencian estos logs; se preservan en disco)
*.log
*.log.err

# Configuración local de agentes (describe el flujo SDD interno; no versionar)
opencode.json
