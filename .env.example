# .env.example — Plantilla de variables de entorno del backend (EasyMarket)
#
# Copiar este archivo como `.env` en la raíz para desarrollo local:
#   cp .env.example .env
#
# NUNCA guardes valores ni secretos reales de producción en este archivo
# ni en ningún archivo subido al repositorio Git. Completa los
# `*_REPLACE_ME` solo en tu `.env` local, que está ignorado por Git
# (esta plantilla NO está ignorada, por la regla `!**/.env.example`
# de `.gitignore` — se verifica con `git check-ignore .env.example`,
# que debe responder sin salida).
#
# Las 11 variables coinciden 1:1 con las que lee el backend en
# `backend/src/main/resources/application-dev.yml` y
# `backend/src/main/resources/application-prod.yml`. Los valores no
# sensibles muestran el default de desarrollo como referencia (ya son
# públicos en esos ficheros versionados); todo lo sensible trae un
# placeholder `REPLACE_ME` imposible de confundir con un valor real
# (sin prefijos de clave ni hashes).

# ─── Base de datos PostgreSQL (BD) ────────────────────────────────────────────
# Host del servidor PostgreSQL (dev local: localhost).
DB_HOST=localhost
# Puerto del servidor PostgreSQL (dev local: 5432).
DB_PORT=5432
# Nombre de la base de datos (dev local: easymarket_dev).
DB_NAME=easymarket_dev
# Usuario de conexión a la base de datos (dev local: easymarket).
DB_USER=easymarket
# Contrasena del usuario de BD — placeholder: completar en el `.env` local.
DB_PASSWORD=REPLACE_ME_DB_PASSWORD

# ─── Stripe (pagos sandbox) ───────────────────────────────────────────────────
# Clave secreta de Stripe en modo test — placeholder: completar en el `.env` local.
STRIPE_SECRET_KEY=REPLACE_ME_STRIPE_SECRET_KEY
# Secreto del webhook que imprime `stripe listen` al reenviar eventos al backend
# local — placeholder: completar en el `.env` local.
STRIPE_WEBHOOK_SECRET=REPLACE_ME_STRIPE_WEBHOOK_SECRET

# ─── JWT (firma de sesión) ────────────────────────────────────────────────────
# Secreto de firma del JWT, mínimo 32 caracteres — placeholder: generar uno local.
JWT_SECRET=REPLACE_ME_JWT_SECRET_MIN_32_CHARS

# ─── CORS / frontend ──────────────────────────────────────────────────────────
# URL pública del frontend aceptada por CORS (dev local: http://localhost:3000).
FRONTEND_URL=http://localhost:3000

# ─── Seed del admin inicial ───────────────────────────────────────────────────
# Email de la cuenta admin creada por el seed de Flyway.
ADMIN_EMAIL=admin@easymarket.com
# Hash BCrypt de la contrasena del admin — placeholder: generar localmente con
# BCrypt y NUNCA versionar el valor real.
ADMIN_PASSWORD_HASH=REPLACE_ME_BCRYPT_HASH
